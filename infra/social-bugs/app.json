{
  "app_name": "nexlink-social-bugs",
  "custom_app": true,
  "custom_compose_config": {
    "services": {
      "social-bugs": {
        "image": "python:3.12-alpine",
        "restart": "unless-stopped",
        "command": ["python3", "-u", "/app/social-bugs"],
        "environment": {
          "PORT": "8066",
          "DB_PATH": "/data/bugs.db",
          "ALERT_QUEUE": "/data/alerts-pending",
          "TZ": "Australia/Sydney"
        },
        "ports": ["8066:8066"],
        "volumes": [
          {"type": "bind", "source": "/mnt/Pool1-MAIN/social/bugs-app", "target": "/app", "read_only": true},
          {"type": "bind", "source": "/mnt/Pool1-MAIN/social/bugs", "target": "/data"}
        ],
        "healthcheck": {
          "test": ["CMD", "python3", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8066/health',timeout=5).status==200 else 1)"],
          "interval": "30s",
          "timeout": "10s",
          "retries": 3,
          "start_period": "10s"
        },
        "deploy": {"resources": {"limits": {"memory": "128M"}}}
      }
    }
  }
}
