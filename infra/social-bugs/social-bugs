#!/usr/bin/env python3
"""
docs/social/38-bug-reports.md — the bug report and feedback service.

Standard library only, by the same reasoning as social-deletion: this is a
single table written a few times a week by humans typing prose, and read by one
person. A framework would be more code to patch than the service contains.

Three surfaces, and the split between them is a security boundary rather than a
tidy-up (§38.6):

    PUBLIC, via nginx on the existing hostname
      POST /api/report          file a report
      GET  /api/report/<code>   status and any reply, for the reporter

    LAN ONLY, reachable solely by hitting this port directly
      GET  /ops                 the operator page, every report in one list
      POST /ops/update          set status / write a reply

nginx (element-web's template) proxies ONLY /api/ — there is no location for
/ops, which is what keeps the operator surface off the public internet and
keeps the Privacy Policy §6.1 promise true. Do not add one. §38.6 lists what
would have to happen first.

Run:  python3 social-bugs            (PORT, DB_PATH from the environment)
"""

import json
import os
import re
import secrets
import sqlite3
import sys
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from html import escape

PORT = int(os.environ.get("PORT", "8066"))
DB_PATH = os.environ.get("DB_PATH", "/data/bugs.db")
# §38.8 — the queue a host-side notifier drains. Written inside the container,
# read outside it, because midclt does not exist in here.
ALERT_QUEUE = os.environ.get("ALERT_QUEUE", "/data/alerts-pending")

MAX_BODY = 8 * 1024          # §38.7.2
RATE_LIMIT = 5               # reports per window per IP
RATE_WINDOW = 3600

# §38.5 — unambiguous alphabet. No O/0, I/1/L, U/V, so a code read off a phone
# screen and typed into a browser survives the trip.
CODE_ALPHABET = "ABCDEFGHJKMNPQRSTWXYZ23456789"
CODE_RE = re.compile(r"^R-[A-Z2-9]{6}$")

# §38.3 is an ALLOWLIST. An unknown key is rejected rather than ignored:
# CareConnect dropped 25 shift reports into a field that did not exist and
# returned success every time, and the same trap is one INSERT away from here.
TEXT_FIELDS = {
    "what_happened": 4000,
    "expected": 4000,
    "app_version": 40,
    "android_version": 40,
    "device_model": 60,
    "screen": 40,
    "mxid": 255,
}
ALLOWED_KEYS = set(TEXT_FIELDS) | {"kind", "source"}
KINDS = ("bug", "feature")
SOURCES = ("app", "web")
STATUSES = ("open", "investigating", "fixed", "wont_fix")

SCHEMA = """
CREATE TABLE IF NOT EXISTS reports (
  id              TEXT PRIMARY KEY,
  kind            TEXT NOT NULL DEFAULT 'bug',
  what_happened   TEXT NOT NULL,
  expected        TEXT,
  app_version     TEXT,
  android_version TEXT,
  device_model    TEXT,
  screen          TEXT,
  mxid            TEXT,
  source          TEXT NOT NULL,
  status          TEXT NOT NULL DEFAULT 'open',
  operator_note   TEXT,
  created         TEXT NOT NULL,
  updated         TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS reports_status  ON reports(status);
CREATE INDEX IF NOT EXISTS reports_created ON reports(created);
"""


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def db():
    c = sqlite3.connect(DB_PATH, timeout=10)
    c.row_factory = sqlite3.Row
    # One writer and a handful of readers; WAL keeps a status update from
    # blocking a report being filed.
    c.execute("PRAGMA journal_mode=WAL")
    return c


def init_db():
    with db() as c:
        c.executescript(SCHEMA)


def new_code(c):
    """A code nobody holds yet. Six characters is 2^29 of space (§38.5)."""
    for _ in range(20):
        code = "R-" + "".join(secrets.choice(CODE_ALPHABET) for _ in range(6))
        if not c.execute("SELECT 1 FROM reports WHERE id=?", (code,)).fetchone():
            return code
    raise RuntimeError("could not find a free reference code")


class Rate:
    """
    Per-IP token bucket, in memory only.

    §38.4.1: the address is used here and written nowhere. A restart forgives
    everyone, which is the right failure direction for a reporting channel —
    the alternative is a persistent limit that locks out the person trying to
    tell you the service is broken.
    """

    def __init__(self):
        self.hits = {}

    def allow(self, ip):
        t = time.time()
        fresh = [x for x in self.hits.get(ip, []) if t - x < RATE_WINDOW]
        if len(fresh) >= RATE_LIMIT:
            self.hits[ip] = fresh
            return False
        fresh.append(t)
        self.hits[ip] = fresh
        if len(self.hits) > 10000:        # cheap unbounded-growth guard
            self.hits = {k: v for k, v in self.hits.items()
                         if any(t - x < RATE_WINDOW for x in v)}
        return True


RATE = Rate()


def queue_alert(code, kind):
    """
    §38.8 — tell somebody, and never let it matter.

    Everything here is inside the caller's try/except. A report that fails to
    save because nobody could be notified about it is worse in every way than
    one that saves quietly; in SOS POS the commit that added notification broke
    reporting outright, which is the whole reason this is a separate statement
    after the row is committed.
    """
    with open(ALERT_QUEUE, "a") as f:
        f.write(json.dumps({"id": code, "kind": kind, "at": now()}) + "\n")


def clean(value, limit):
    if value is None:
        return None
    s = str(value).replace("\r\n", "\n").strip()
    if not s:
        return None
    return s[:limit]


def create_report(payload, ip):
    unknown = set(payload) - ALLOWED_KEYS
    if unknown:
        # Named, so a client author sees which key was wrong rather than
        # guessing why a report vanished.
        return 400, {"error": "unknown field(s): " + ", ".join(sorted(unknown))}

    what = clean(payload.get("what_happened"), TEXT_FIELDS["what_happened"])
    if not what:
        return 400, {"error": "Tell us what happened — that field cannot be empty."}

    kind = payload.get("kind", "bug")
    if kind not in KINDS:
        return 400, {"error": "kind must be one of: " + ", ".join(KINDS)}
    source = payload.get("source", "web")
    if source not in SOURCES:
        return 400, {"error": "source must be one of: " + ", ".join(SOURCES)}

    if not RATE.allow(ip):
        # 429 with words, never a silent drop (§38.10 #1).
        return 429, {"error": "That is several reports in a short time. "
                              "Please wait an hour, or email the address in the "
                              "Privacy Policy if it is urgent."}

    row = {k: clean(payload.get(k), lim) for k, lim in TEXT_FIELDS.items()}
    row["what_happened"] = what
    row["kind"] = kind
    row["source"] = source
    stamp = now()

    with db() as c:
        code = new_code(c)
        c.execute(
            "INSERT INTO reports (id,kind,what_happened,expected,app_version,"
            "android_version,device_model,screen,mxid,source,status,created,updated)"
            " VALUES (?,?,?,?,?,?,?,?,?,?,'open',?,?)",
            (code, kind, row["what_happened"], row["expected"], row["app_version"],
             row["android_version"], row["device_model"], row["screen"], row["mxid"],
             source, stamp, stamp))

    try:
        queue_alert(code, kind)
    except Exception as e:                      # noqa: BLE001 — see queue_alert
        print(f"alert queue failed (report {code} is saved): {e}", flush=True)

    return 201, {"id": code}


def lookup(code):
    """What the reporter may read back: their own words, the status, the reply."""
    if not CODE_RE.match(code or ""):
        return 404, {"error": "No report with that reference."}
    with db() as c:
        r = c.execute("SELECT id,kind,what_happened,expected,status,operator_note,"
                      "created,updated FROM reports WHERE id=?", (code,)).fetchone()
    if not r:
        return 404, {"error": "No report with that reference."}
    return 200, dict(r)


# ── the operator page ───────────────────────────────────────────────────────
# Deliberately plain HTML with no JavaScript framework and no login, because it
# is unreachable from outside the LAN (§38.6). If that ever changes, this file
# is the wrong place to bolt a password onto — read §38.6 first.

OPS_CSS = """
body{font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
     max-width:62rem;margin:0 auto;padding:1.5rem 1rem 4rem;background:#fbfbfd;color:#16161a}
h1{font-size:1.4rem;margin:0 0 .25rem}
.sub{color:#6b6b73;margin:0 0 1.5rem}
.r{background:#fff;border:1px solid #e3e3e8;border-radius:.5rem;padding:1rem 1.1rem;margin:0 0 .85rem}
.r.fixed,.r.wont_fix{opacity:.6}
.hd{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin-bottom:.5rem}
code{background:#f1f1f5;padding:.15rem .4rem;border-radius:.25rem;font-size:.9em}
.tag{font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;
     padding:.18rem .45rem;border-radius:.25rem;background:#ececf2;color:#4a4a55}
.tag.bug{background:#fdecea;color:#9f2d20}
.tag.feature{background:#eaf3fd;color:#1f5d9c}
.body{white-space:pre-wrap;margin:.3rem 0}
.meta{color:#6b6b73;font-size:.84rem;margin-top:.55rem}
.note{background:#f6f6fa;border-left:3px solid #c9c9d2;padding:.5rem .75rem;margin:.6rem 0 0}
form{margin-top:.7rem;display:flex;flex-wrap:wrap;gap:.4rem}
select,input[type=text]{padding:.4rem;border:1px solid #c9c9d2;border-radius:.3rem;font:inherit}
input[type=text]{flex:1;min-width:14rem}
