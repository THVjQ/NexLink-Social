       font:inherit;cursor:pointer}
.empty{text-align:center;color:#6b6b73;padding:3rem 1rem}
@media(prefers-color-scheme:dark){
  body{background:#15151a;color:#ececf1}
  .r{background:#1e1e25;border-color:#2e2e38}
  code,.note{background:#26262f}.note{border-left-color:#3a3a46}
  .tag{background:#2e2e38;color:#c9c9d2}
  .tag.bug{background:#3a1f1c;color:#f0a79c}
  .tag.feature{background:#1b2c40;color:#9ec5ef}
  .meta,.sub,.empty{color:#9a9aa4}
  select,input[type=text]{background:#26262f;color:inherit;border-color:#3a3a46}
  button{background:#ececf1;color:#15151a}
}
"""


def ops_page():
    with db() as c:
        rows = c.execute(
            # open first, then by age: the list is a work queue, not an archive.
            "SELECT * FROM reports ORDER BY "
            "CASE status WHEN 'open' THEN 0 WHEN 'investigating' THEN 1 ELSE 2 END,"
            "created DESC").fetchall()

    open_n = sum(1 for r in rows if r["status"] == "open")
    out = [f"<!doctype html><meta charset=utf-8>"
           f"<meta name=viewport content='width=device-width,initial-scale=1'>"
           f"<title>Bug reports — NexLink Social</title><style>{OPS_CSS}</style>"
           f"<h1>Bug reports</h1>"
           f"<p class=sub>{len(rows)} total, <strong>{open_n} open</strong>. "
           f"§38 — this page is LAN-only by design.</p>"]

    if not rows:
        out.append("<div class=empty>Nothing reported yet.</div>")

    for r in rows:
        note = r["operator_note"]
        out.append(f"<div class='r {escape(r['status'])}'>")
        out.append(f"<div class=hd><code>{escape(r['id'])}</code>"
                   f"<span class='tag {escape(r['kind'])}'>{escape(r['kind'])}</span>"
                   f"<span class=tag>{escape(r['status'])}</span></div>")
        out.append(f"<div class=body>{escape(r['what_happened'])}</div>")
        if r["expected"]:
            out.append(f"<div class=body><em>Expected:</em> {escape(r['expected'])}</div>")
        bits = [r["created"], r["source"]]
        for k in ("app_version", "android_version", "device_model", "screen"):
            if r[k]:
                bits.append(f"{k.replace('_', ' ')}: {r[k]}")
        bits.append(escape(r["mxid"]) if r["mxid"] else "anonymous — no reply possible")
        out.append(f"<div class=meta>{escape(' · '.join(str(b) for b in bits))}</div>")
        if note:
            out.append(f"<div class=note><strong>Reply:</strong> {escape(note)}</div>")
        opts = "".join(
            f"<option value={s}{' selected' if s == r['status'] else ''}>{s}</option>"
            for s in STATUSES)
        out.append(
            f"<form method=post action=/ops/update>"
            f"<input type=hidden name=id value='{escape(r['id'])}'>"
            f"<select name=status>{opts}</select>"
            f"<input type=text name=operator_note placeholder='Reply the reporter will see'"
            f" value='{escape(note or '')}'>"
            f"<button type=submit>Save</button></form>")
        out.append("</div>")
    return "".join(out)


class Handler(BaseHTTPRequestHandler):
    server_version = "social-bugs"

    # §38.4.1 / §2.8 #7 — the default handler logs a request line carrying the
    # path and the client address. Silenced: nothing here needs a request log,
    # and one that records who looked up which reference is a record this
    # service has promised not to keep.
    def log_message(self, *a):
        pass

    def client_ip(self):
        """
        The address to rate-limit on — never stored (§38.4.1).

        Order matters. CF-Connecting-IP is set by Cloudflare itself and is the
        real client for anything arriving through the tunnel. X-Forwarded-For
        is trusted only because nginx OVERWRITES it with the peer address
        rather than appending (see the /bugs/api/ block): were it appended, a
        client could put any value at the head of the list and mint itself a
        fresh rate-limit bucket on every request.
        """
        cf = (self.headers.get("CF-Connecting-IP") or "").strip()
        if cf:
            return cf
        fwd = (self.headers.get("X-Forwarded-For") or "").strip()
        if fwd:
            return fwd.split(",")[0].strip()
        return self.client_address[0]

    def send_json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(body)

    def send_html(self, code, html):
        body = html.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Allow-Methods", "POST, GET, OPTIONS")
        self.end_headers()

    def do_GET(self):
        path = self.path.split("?")[0].rstrip("/") or "/"
        if path == "/health":
            return self.send_json(200, {"ok": True})
        if path == "/ops":
            return self.send_html(200, ops_page())
        if path.startswith("/api/report/"):
            code, body = lookup(path[len("/api/report/"):].upper())
            return self.send_json(code, body)
        self.send_json(404, {"error": "not found"})

    def do_POST(self):
        path = self.path.split("?")[0].rstrip("/") or "/"
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            return self.send_json(400, {"error": "bad Content-Length"})
        if length > MAX_BODY:
            return self.send_json(413, {"error": "That is longer than this form accepts."})
        raw = self.rfile.read(length) if length else b""

        if path == "/api/report":
            try:
                payload = json.loads(raw or b"{}")
            except ValueError:
                return self.send_json(400, {"error": "body must be JSON"})
            if not isinstance(payload, dict):
                return self.send_json(400, {"error": "body must be a JSON object"})
            try:
                code, body = create_report(payload, self.client_ip())
            except Exception as e:                   # noqa: BLE001
                print(f"create failed: {type(e).__name__}", flush=True)
                return self.send_json(500, {"error": "The report could not be saved. "
                                                     "Nothing was recorded — please try again."})
            return self.send_json(code, body)

        if path == "/ops/update":
            from urllib.parse import parse_qs
            form = parse_qs(raw.decode("utf-8", "replace"))
            rid = (form.get("id") or [""])[0]
            status = (form.get("status") or [""])[0]
            note = clean((form.get("operator_note") or [""])[0], 4000)
            if not CODE_RE.match(rid) or status not in STATUSES:
                return self.send_html(400, "<p>Bad update.</p>")
            with db() as c:
                c.execute("UPDATE reports SET status=?,operator_note=?,updated=? WHERE id=?",
                          (status, note, now(), rid))
            self.send_response(303)
            self.send_header("Location", "/ops")
            self.end_headers()
            return

        self.send_json(404, {"error": "not found"})


def main():
    init_db()
    print(f"social-bugs listening on {PORT}, db {DB_PATH}", flush=True)
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()


if __name__ == "__main__":
    sys.exit(main())
